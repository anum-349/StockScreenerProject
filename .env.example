# Copy this file to .env and replace placeholder values.
# Example:
# cp .env.example .env

FLASK_APP=StockScreener.py
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Optional app secret used for Flask sessions and cookies
FLASK_SECRET_KEY=change-me

# Optional market-data API token if you extend the project to use EODHD or another provider
EODHD_API_TOKEN=your_eodhd_api_token_here
